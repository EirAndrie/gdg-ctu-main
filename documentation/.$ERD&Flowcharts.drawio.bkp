        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    ADMINS {\n        uuid id PK\n        varchar clerk_id UK\n        varchar email UK\n        varchar password_hash\n        varchar first_name\n        varchar last_name\n        text profile_img_url\n        boolean is_active\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    TEAM_MEMBERS {\n        uuid id PK\n        varchar first_name\n        varchar last_name\n        varchar slug UK\n        text bio\n        varchar department\n        varchar program\n        varchar year_section\n        uuid profile_media_id FK\n        varchar linkedin_url\n        varchar github_url\n        varchar website_url\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    TERMS {\n        uuid id PK\n        varchar name UK\n        date start_date\n        date end_date\n        boolean is_current\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    MEMBER_TERMS {\n        uuid id PK\n        uuid member_id FK\n        uuid term_id FK\n        varchar role\n        integer display_order\n        boolean is_active\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    EVENTS {\n        uuid id PK\n        varchar title\n        varchar slug UK\n        text short_description\n        text description\n        uuid cover_media_id FK\n        varchar location\n        varchar location_embed_url\n        boolean registration_enabled\n        timestamp start_at\n        timestamp end_at\n        varchar status\n        timestamp published_at\n        uuid created_by FK\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    EVENT_ATTENDEES {\n        uuid id PK\n        uuid event_id FK\n        varchar first_name\n        varchar last_name\n        varchar email\n        varchar phone\n        varchar organization\n        varchar job_title\n        varchar registration_status\n        timestamp registered_at\n        timestamp attended_at\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    EVENT_HOSTS {\n        uuid id PK\n        uuid event_id FK\n        uuid team_member_id FK\n        varchar host_role\n        integer display_order\n    }\n\n    EVENT_SPEAKERS {\n        uuid id PK\n        uuid event_id FK\n        varchar first_name\n        varchar last_name\n        varchar slug UK\n        varchar role\n        text bio\n        uuid profile_media_id FK\n        varchar linkedin_url\n        varchar github_url\n        varchar website_url\n        uuid team_member_id FK\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    MEDIA {\n        uuid id PK\n        varchar cloudinary_asset_id UK\n        varchar public_id UK\n        text secure_url\n        varchar resource_type\n        varchar format\n        integer width\n        integer height\n        integer bytes\n        varchar original_filename\n        varchar alt_text\n        uuid uploaded_by FK\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    MEDIA_COLLECTIONS {\n        uuid id PK\n        varchar name\n        varchar slug UK\n        text description\n        uuid cover_media_id FK\n        uuid created_by FK\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    MEDIA_COLLECTION_ITEMS {\n        uuid collection_id PK, FK\n        uuid media_id PK, FK\n        integer display_order\n        varchar caption\n        timestamp added_at\n    }\n\n    SITE_CONTENT {\n        uuid id PK\n        varchar section_key UK\n        varchar title\n        text subtitle\n        text body\n        uuid media_id FK\n        varchar button_text\n        varchar button_url\n        boolean is_active\n        timestamp updated_at\n        uuid updated_by FK\n    }\n\n\n    ADMINS ||--o{ EVENTS : creates\n    ADMINS ||--o{ MEDIA : uploads\n    ADMINS ||--o{ MEDIA_COLLECTIONS : creates\n    ADMINS ||--o{ SITE_CONTENT : updates\n\n    MEDIA ||--o{ TEAM_MEMBERS : \&quot;profile image\&quot;\n    MEDIA ||--o{ EVENTS : \&quot;cover image\&quot;\n    MEDIA ||--o{ EVENT_SPEAKERS : \&quot;profile image\&quot;\n    MEDIA ||--o{ MEDIA_COLLECTIONS : \&quot;cover image\&quot;\n    MEDIA ||--o{ MEDIA_COLLECTION_ITEMS : contains\n    MEDIA ||--o{ SITE_CONTENT : \&quot;content image\&quot;\n\n    TEAM_MEMBERS ||--o{ MEMBER_TERMS : has\n    TERMS ||--o{ MEMBER_TERMS : contains\n\n    EVENTS ||--o{ EVENT_ATTENDEES : has\n    EVENTS ||--o{ EVENT_HOSTS : has\n    TEAM_MEMBERS ||--o{ EVENT_HOSTS : hosts\n\n    EVENTS ||--o{ EVENT_SPEAKERS : has\n    TEAM_MEMBERS ||--o{ EVENT_SPEAKERS : \&quot;can be\&quot;\n\n    MEDIA_COLLECTIONS ||--o{ MEDIA_COLLECTION_ITEMS : contains&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1yA9AvOtJNIiadArCX1i-137">
