# Copy this file to `.env` and fill in the values.
# Backend API base URL, INCLUDING the base path:
# e.g. VITE_API_URL=https://<backend-host>/GDGoC-CTU-Main/v0.0.1
VITE_API_URL=

# Clerk publishable key — must come from the SAME Clerk app as the backend.
# e.g. VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=
