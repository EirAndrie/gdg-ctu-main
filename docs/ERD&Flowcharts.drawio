        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    ADMINS {\n        UUID id PK\n        VARCHAR email UK\n        VARCHAR password_hash\n        VARCHAR first_name\n        VARCHAR last_name\n        BOOLEAN is_active\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    TEAM_MEMBERS {\n        UUID id PK\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR slug UK\n        VARCHAR role\n        TEXT bio\n        UUID profile_media_id FK\n        VARCHAR linkedin_url\n        VARCHAR github_url\n        VARCHAR website_url\n        INT display_order\n        BOOLEAN is_active\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    EVENTS {\n        UUID id PK\n        VARCHAR title\n        VARCHAR slug UK\n        TEXT short_description\n        TEXT description\n        UUID cover_media_id FK\n        VARCHAR location\n        VARCHAR registration_url\n        TIMESTAMP registration_deadline\n        TIMESTAMP start_at\n        TIMESTAMP end_at\n        VARCHAR status\n        TIMESTAMP published_at\n        UUID created_by FK\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    EVENT_HOSTS {\n        UUID event_id PK, FK\n        UUID team_member_id PK, FK\n        VARCHAR host_role\n        INT display_order\n    }\n\n    EVENT_ATTENDEES {\n        UUID id PK\n        UUID event_id FK\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR email\n        VARCHAR phone\n        VARCHAR organization\n        VARCHAR job_title\n        VARCHAR registration_status\n        TIMESTAMP registered_at\n        TIMESTAMP attended_at\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    MEDIA {\n        UUID id PK\n        UUID uploaded_by FK\n        VARCHAR filename\n        VARCHAR storage_key UK\n        VARCHAR url\n        VARCHAR mime_type\n        BIGINT file_size\n        INT width\n        INT height\n        VARCHAR alt_text\n        TIMESTAMP created_at\n    }\n\n    MEDIA_COLLECTIONS {\n        UUID id PK\n        VARCHAR name\n        VARCHAR slug UK\n        TEXT description\n        UUID cover_media_id FK\n        UUID created_by FK\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    MEDIA_COLLECTION_ITEMS {\n        UUID collection_id PK, FK\n        UUID media_id PK, FK\n        INT display_order\n        VARCHAR caption\n        TIMESTAMP added_at\n    }\n\n    SITE_CONTENT {\n        UUID id PK\n        VARCHAR section_key UK\n        VARCHAR title\n        VARCHAR subtitle\n        TEXT body\n        UUID media_id FK\n        VARCHAR button_text\n        VARCHAR button_url\n        BOOLEAN is_active\n        UUID updated_by FK\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n\n    ADMINS ||--o{ EVENTS : creates\n    ADMINS ||--o{ MEDIA : uploads\n    ADMINS ||--o{ MEDIA_COLLECTIONS : creates\n    ADMINS ||--o{ SITE_CONTENT : updates\n\n    TEAM_MEMBERS ||--o{ EVENT_HOSTS : hosts\n    EVENTS ||--o{ EVENT_HOSTS : has_hosts\n\n    EVENTS ||--o{ EVENT_ATTENDEES : has_attendees\n\n    MEDIA ||--o{ TEAM_MEMBERS : profile_image\n    MEDIA ||--o{ EVENTS : cover_image\n\n    MEDIA_COLLECTIONS ||--o{ MEDIA_COLLECTION_ITEMS : contains\n    MEDIA ||--o{ MEDIA_COLLECTION_ITEMS : belongs_to\n\n    MEDIA ||--o{ MEDIA_COLLECTIONS : collection_cover\n    MEDIA ||--o{ SITE_CONTENT : section_image&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xD0JK3srpxSHjVl_g-pz-281">
